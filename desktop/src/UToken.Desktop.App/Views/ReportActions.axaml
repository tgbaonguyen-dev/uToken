<UserControl xmlns="https://github.com/avaloniaui" xmlns:l="using:UToken.Desktop.App.Localization" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="UToken.Desktop.App.Views.ReportActions" x:CompileBindings="False">
 <StackPanel Spacing="8"><WrapPanel><Button x:Name="CopyReportButton" Content="{l:T 'Copy report'}" Click="CopyClicked" Margin="0,0,10,6"/><Button x:Name="SaveReportButton" Content="{l:T 'Save report'}" Click="SaveClicked" Margin="0,0,0,6"/></WrapPanel><TextBlock x:Name="ReportActionStatus" FontSize="11" TextWrapping="Wrap"/></StackPanel>
</UserControl>
