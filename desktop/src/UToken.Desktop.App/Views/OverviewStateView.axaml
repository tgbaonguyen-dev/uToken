<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="using:UToken.Desktop.App.Views"
 xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Avalonia.Svg.Skia"
 x:Class="UToken.Desktop.App.Views.OverviewStateView" x:CompileBindings="True" x:DataType="vm:MainViewModel" xmlns:vm="using:UToken.Desktop.App.ViewModels" xmlns:m="using:UToken.Desktop.App.Models">
 <UserControl.Resources>
 <DataTemplate x:Key="StateDetails" x:DataType="m:HealthData"><Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,17"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding Label}" Classes="muted" FontSize="11" Margin="0,0,12,0" TextWrapping="Wrap"/><TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="{Binding Color}" FontSize="11" MaxWidth="200" TextWrapping="Wrap" TextAlignment="Right"/></Grid></Border></DataTemplate>
 </UserControl.Resources>
 <StackPanel Spacing="24">
 <Border Classes="card" Padding="28" ClipToBounds="True">
 <Grid>
 <Ellipse Width="340" Height="220" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-100,-40,0" Opacity="0.1" Fill="{Binding OverviewPreview.Scenario.Accent}" IsVisible="{Binding !IsGenericOverviewPreview}"><Ellipse.Effect><BlurEffect Radius="70"/></Ellipse.Effect></Ellipse>
 <StackPanel Spacing="26">
 <Border CornerRadius="9" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Background="#191C20" Padding="10,7" HorizontalAlignment="Left" IsVisible="{Binding !IsGenericOverviewPreview}"><StackPanel Orientation="Horizontal" Spacing="8"><Ellipse Classes="status-dot" Fill="{Binding OverviewPreview.Scenario.Accent}"/><TextBlock Text="{Binding OverviewPreview.Scenario.Status}" FontSize="10"/></StackPanel></Border>
 <Grid ColumnDefinitions="64,24,*">
 <Border CornerRadius="20" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Background="#191C20" Width="64" Height="64" VerticalAlignment="Top"><Grid>
 <TextBlock Text="{Binding OverviewPreview.Scenario.Code}" FontSize="25" Foreground="{Binding OverviewPreview.Scenario.Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsGenericOverviewPreview}"/>
 <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="5" IsVisible="{Binding IsOfflinePreview}"><Border Width="30" Height="23" CornerRadius="7" BorderBrush="{Binding OverviewPreview.Scenario.Accent}" BorderThickness="1" Background="{StaticResource PageBrush}"/><Border Width="14" Height="3" CornerRadius="2" Background="{Binding OverviewPreview.Scenario.Accent}"/></StackPanel>
 <Border Width="25" Height="25" CornerRadius="8" BorderBrush="{Binding OverviewPreview.Scenario.Accent}" BorderThickness="1" Background="{StaticResource PageBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsEmptyPreview}"><Ellipse Classes="status-dot" Fill="{Binding OverviewPreview.Scenario.Accent}" HorizontalAlignment="Center"/></Border>
 </Grid></Border>
 <StackPanel Grid.Column="2" Spacing="12"><TextBlock Text="{Binding OverviewPreview.Scenario.Headline}" FontSize="25" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding OverviewPreview.Scenario.Description}" Classes="muted" FontSize="12" TextWrapping="Wrap"/>
 <TextBlock Text="{Binding OverviewPreview.LastCollected}" Classes="muted" FontSize="10" IsVisible="{Binding IsOfflinePreview}"/>
 <TextBlock Text="{Binding SupportedSources.Length, StringFormat='Watching {0} supported sources'}" Classes="muted" FontSize="10" IsVisible="{Binding IsEmptyPreview}"/>
 </StackPanel></Grid>
 <StackPanel Spacing="14" IsVisible="{Binding IsGenericOverviewPreview}" Margin="0,10,0,0"><TextBlock Text="DETAILS" Classes="label"/><Border Background="#191A1C" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="14" Padding="20,4"><ItemsControl ItemsSource="{Binding OverviewPreview.Scenario.Details}" ItemTemplate="{StaticResource StateDetails}"/></Border>
 <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsScanningPreview}" Foreground="{Binding OverviewPreview.Scenario.Accent}" Margin="0,4"/>
 </StackPanel>
 <WrapPanel IsEnabled="{Binding !IsBusy}"><Button Classes="primary" Content="{Binding OverviewPreview.Scenario.PrimaryLabel}" Command="{Binding OverviewStateActionCommand}" CommandParameter="{Binding OverviewPreview.Scenario.PrimaryAction}" MinWidth="170" Margin="0,0,12,8"/><Button Content="{Binding OverviewPreview.Scenario.SecondaryLabel}" Command="{Binding OverviewStateActionCommand}" CommandParameter="{Binding OverviewPreview.Scenario.SecondaryAction}" MinWidth="150" Margin="0,0,12,8"/><Border x:Name="EmptyCollectorHealthBadge" IsVisible="{Binding IsEmptyPreview}" Background="#191C20" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="9" Padding="10,7" Margin="0,0,0,8" VerticalAlignment="Center"><StackPanel Orientation="Horizontal" Spacing="8"><Ellipse Classes="status-dot"/><TextBlock Text="Collector healthy" FontSize="10"/></StackPanel></Border><Border IsVisible="{Binding IsOfflinePreview}" Background="#191C20" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="9" Padding="10,7" Margin="0,0,0,8" VerticalAlignment="Center"><StackPanel Orientation="Horizontal" Spacing="8"><Ellipse Classes="status-dot" Fill="{Binding OverviewPreview.Scenario.Accent}"/><TextBlock Text="Collector offline" FontSize="10"/></StackPanel></Border></WrapPanel>
 </StackPanel></Grid></Border>
 <Grid ColumnDefinitions="1.8*,20,*" IsVisible="{Binding !IsGenericOverviewPreview}">
 <Border Classes="card" IsVisible="{Binding IsOfflinePreview}"><StackPanel Spacing="18"><TextBlock Text="Last known activity" Classes="heading"/>
 <ItemsControl ItemsSource="{Binding OverviewPreview.RecentActivity}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="m:ActivityData"><Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,18"><Grid ColumnDefinitions="14,52,*,65,62"><Ellipse Classes="status-dot" Fill="{Binding Color}"/><TextBlock Grid.Column="1" Text="{Binding TimeLabel}" Classes="muted" FontSize="10"/><TextBlock Grid.Column="2" Text="{Binding Provider}" FontSize="11"/><TextBlock Grid.Column="3" Text="{Binding TokenLabel}" TextAlignment="Right" FontSize="11"/><TextBlock Grid.Column="4" Text="Collected" Foreground="{StaticResource SuccessBrush}" TextAlignment="Right" FontSize="10"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
 <TextBlock Text="No new events were collected while the collector was offline." Foreground="{Binding OverviewPreview.Scenario.Accent}" FontSize="10" TextWrapping="Wrap"/>
 </StackPanel></Border>
 <Border Classes="card" IsVisible="{Binding IsEmptyPreview}"><StackPanel Spacing="18"><TextBlock Text="Get your first activity" Classes="heading"/>
 <ItemsControl ItemsSource="{Binding OverviewPreview.Scenario.Guide}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="m:SetupStep"><Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,16"><Grid ColumnDefinitions="32,16,*"><Border CornerRadius="9" Background="#191C20" Width="32" Height="32"><TextBlock Text="{Binding Number}" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="11"/></Border><StackPanel Grid.Column="2" Spacing="8"><TextBlock Text="{Binding Title}" FontSize="12" TextWrapping="Wrap"/><TextBlock Text="{Binding Description}" Classes="muted" FontSize="10" TextWrapping="Wrap"/></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
 </StackPanel></Border>
 <Border Grid.Column="2" Classes="card"><StackPanel Spacing="14">
 <StackPanel IsVisible="{Binding IsOfflinePreview}" Spacing="14"><TextBlock Text="What happened" Classes="heading"/><ItemsControl ItemsSource="{Binding OverviewPreview.Scenario.Details}" ItemTemplate="{StaticResource StateDetails}"/><TextBlock Text="Restarting rescans every enabled source; collected history is kept." Classes="muted" FontSize="10" TextWrapping="Wrap"/></StackPanel>
 <StackPanel IsVisible="{Binding IsEmptyPreview}" Spacing="20"><TextBlock Text="Watching now" Classes="heading"/><ItemsControl ItemsSource="{Binding SupportedSources}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="m:SupportedSourceData"><Grid ColumnDefinitions="32,12,*,Auto" Margin="0,10"><Image Source="{Binding Logo, Converter={x:Static views:SvgLogo.Instance}}" Width="32" Height="32"/><TextBlock Grid.Column="2" Text="{Binding Name}" VerticalAlignment="Center" FontSize="12"/><Ellipse Grid.Column="3" Classes="status-dot"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="Prompt and response content are never read or stored." Classes="muted" FontSize="10" TextWrapping="Wrap"/></StackPanel>
 </StackPanel></Border>
 </Grid>
 </StackPanel>
</UserControl>
