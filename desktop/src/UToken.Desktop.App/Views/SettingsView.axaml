<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:views="using:UToken.Desktop.App.Views"
 x:Class="UToken.Desktop.App.Views.SettingsView" x:CompileBindings="False">
 <UserControl.Resources><SolidColorBrush x:Key="ToggleSwitchFillOn">#2EC790</SolidColorBrush><SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver">#37D99F</SolidColorBrush><SolidColorBrush x:Key="ToggleSwitchFillOnPressed">#25A879</SolidColorBrush></UserControl.Resources>
 <StackPanel Spacing="16">
 <TextBlock Text="{Binding SettingsMessage}" IsVisible="{Binding HasSettingsMessage}" TextWrapping="Wrap" Foreground="{StaticResource SuccessBrush}"/>
 <Border Classes="card" IsVisible="{Binding HasDiagnosticsReport}">
 <StackPanel Spacing="12"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Application diagnostics" Classes="heading"/><Button Grid.Column="1" Content="Close" Command="{Binding CloseDiagnosticsCommand}"/></Grid>
 <ScrollViewer MaxHeight="280"><SelectableTextBlock Text="{Binding DiagnosticsReport}" TextWrapping="Wrap" FontSize="11"/></ScrollViewer><views:ReportActions Report="{Binding DiagnosticsReport}"/></StackPanel>
 </Border>
 <Grid ColumnDefinitions="*,20,*" IsEnabled="{Binding !IsBusy}">
 <Border Classes="card"><StackPanel Spacing="6"><TextBlock Text="Collector" Classes="heading"/>
 <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,18"><Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="8"><TextBlock Text="Launch at startup" FontSize="12"/><TextBlock Text="Start after sign-in" Classes="muted" FontSize="10"/></StackPanel><ToggleSwitch Grid.Column="1" IsChecked="{Binding LaunchAtStartup, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center" AutomationProperties.Name="Launch at startup"/></Grid></Border><Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,18"><Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="8"><TextBlock Text="Background collection" FontSize="12"/><TextBlock Text="Keep the app in the system tray when closed" Classes="muted" FontSize="10"/></StackPanel><ToggleSwitch Grid.Column="1" IsChecked="{Binding BackgroundCollection, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center" AutomationProperties.Name="Background collection"/></Grid></Border><Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,18"><Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="8"><TextBlock Text="Automatic updates" FontSize="12"/><TextBlock Text="Install stable updates" Classes="muted" FontSize="10"/></StackPanel><ToggleSwitch Grid.Column="1" IsChecked="{Binding AutomaticUpdates, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center" AutomationProperties.Name="Automatic updates"/></Grid></Border><Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,18"><Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="8"><TextBlock Text="Usage notifications" FontSize="12"/><TextBlock Text="Alert on spending changes" Classes="muted" FontSize="10"/></StackPanel><ToggleSwitch Grid.Column="1" IsChecked="{Binding UsageNotifications, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center" AutomationProperties.Name="Usage notifications"/></Grid></Border>
 <Button Content="Review setup" Command="{Binding ShowFirstRunCommand}" Margin="0,16,0,0"/>
 <TextBlock Text="Local storage" Classes="heading" Margin="0,28,0,10"/>
 <Grid ColumnDefinitions="*,Auto" Margin="0,10"><StackPanel Spacing="8" Margin="0,0,12,0"><TextBlock Text="Collector data path" Classes="muted" FontSize="10"/><TextBlock Text="{Binding Settings.DataPath}" FontSize="11" TextWrapping="Wrap"/></StackPanel><Button Grid.Column="1" Content="Open folder" Click="OpenFolderClicked" VerticalAlignment="Center"/></Grid>
 <Grid ColumnDefinitions="*,Auto" Margin="0,16"><StackPanel Spacing="8" Margin="0,0,12,0"><TextBlock Text="App version" Classes="muted" FontSize="10"/><TextBlock Text="{Binding Settings.AppVersion}" FontSize="11" TextWrapping="Wrap"/></StackPanel><Button Grid.Column="1" Content="Check updates" Command="{Binding SettingsActionCommand}" CommandParameter="updates" VerticalAlignment="Center"/></Grid>
 </StackPanel></Border>
 <StackPanel Grid.Column="2" Spacing="20">
 <Border Classes="card"><StackPanel Spacing="18"><TextBlock Text="Privacy &amp; retention" Classes="heading"/>
 <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,10,0,18"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Prompt content" Classes="muted" FontSize="11"/><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7"><Ellipse Classes="status-dot"/><TextBlock Text="Never collected" Foreground="{StaticResource SuccessBrush}" FontSize="11"/></StackPanel></Grid></Border>
 <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,18"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="AI responses" Classes="muted" FontSize="11"/><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7"><Ellipse Classes="status-dot"/><TextBlock Text="Never collected" Foreground="{StaticResource SuccessBrush}" FontSize="11"/></StackPanel></Grid></Border>
 <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Retention period" Classes="muted" FontSize="11" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"><ComboBox x:Name="RetentionSelector" ItemsSource="{Binding Settings.RetentionOptions}" SelectedItem="{Binding SelectedRetention, Mode=TwoWay}" MinWidth="70" AutomationProperties.Name="Retention days"/><TextBlock Text="days" VerticalAlignment="Center" FontSize="11"/></StackPanel></Grid>
 <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Cloud sync" Classes="muted" FontSize="11"/><TextBlock Grid.Column="1" Text="Encrypted (demo)" FontSize="11"/></Grid>
 </StackPanel></Border>
 <Border Classes="card"><StackPanel Spacing="18"><TextBlock Text="Data management" Classes="heading"/><TextBlock Text="Export collected metadata or simulate local data removal." Classes="muted" FontSize="11" TextWrapping="Wrap"/>
 <WrapPanel><Button Content="Export data" Click="ExportClicked" Margin="0,0,10,8"/><Button Content="Clear local data" Command="{Binding RequestClearDataCommand}" Margin="0,0,0,8"/></WrapPanel>
 <Border IsVisible="{Binding ConfirmClearData}" BorderBrush="#F26039" BorderThickness="1" CornerRadius="8" Padding="12"><StackPanel Spacing="10"><TextBlock Text="Simulate clearing local records? JSON fixtures will be retained." TextWrapping="Wrap" FontSize="11"/><WrapPanel><Button Content="Confirm simulation" Command="{Binding SettingsActionCommand}" CommandParameter="clear" Margin="0,0,8,0"/><Button Content="Cancel" Command="{Binding CancelClearDataCommand}"/></WrapPanel></StackPanel></Border>
 <Border Background="{StaticResource LineBrush}" Height="1"/>
 <StackPanel Spacing="8"><TextBlock Text="Collector diagnostics" FontSize="12"/><TextBlock Text="Logs contain metadata only." Classes="muted" FontSize="10"/><Button Content="Open diagnostics" Command="{Binding OpenDiagnosticsCommand}" Margin="0,6,0,0"/></StackPanel>
 </StackPanel></Border></StackPanel></Grid>

 <TextBlock Text="Preferences are saved locally. On Windows, closing to tray uses the saved background setting. Startup, updates, notifications and data collection remain simulated." Classes="muted" FontSize="10" TextWrapping="Wrap"/>
 </StackPanel>
</UserControl>
