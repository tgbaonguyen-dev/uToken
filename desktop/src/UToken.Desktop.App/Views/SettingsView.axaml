<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:views="using:UToken.Desktop.App.Views"
 x:Class="UToken.Desktop.App.Views.SettingsView" x:CompileBindings="False">
 <UserControl.Styles><Style Selector="TextBlock.judge-message"><Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/></Style><Style Selector="TextBlock.judge-message.judge-error"><Setter Property="Foreground" Value="#F26039"/></Style></UserControl.Styles>
 <UserControl.Resources><SolidColorBrush x:Key="ToggleSwitchFillOn">#2EC790</SolidColorBrush><SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver">#37D99F</SolidColorBrush><SolidColorBrush x:Key="ToggleSwitchFillOnPressed">#25A879</SolidColorBrush></UserControl.Resources>
 <StackPanel Spacing="16">
 <TextBlock Text="{Binding SettingsMessage}" IsVisible="{Binding HasSettingsMessage}" TextWrapping="Wrap" Foreground="{StaticResource SuccessBrush}"/>
 <Border Classes="card" IsVisible="{Binding HasDiagnosticsReport}">
 <StackPanel Spacing="12"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Application diagnostics" Classes="heading"/><Button Grid.Column="1" Content="Close" Command="{Binding CloseDiagnosticsCommand}"/></Grid>
 <ScrollViewer MaxHeight="280"><SelectableTextBlock Text="{Binding DiagnosticsReport}" TextWrapping="Wrap" FontSize="11"/></ScrollViewer><views:ReportActions Report="{Binding DiagnosticsReport}"/></StackPanel>
 </Border>
 <Grid ColumnDefinitions="*,20,*" IsEnabled="{Binding !IsBusy}">
 <Border Classes="card"><StackPanel Spacing="6"><TextBlock Text="Collector" Classes="heading"/>
 <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,18"><Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="8"><TextBlock Text="Launch at startup" FontSize="12"/><TextBlock Text="Start after sign-in" Classes="muted" FontSize="10"/></StackPanel><ToggleSwitch Grid.Column="1" IsChecked="{Binding LaunchAtStartup, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center" AutomationProperties.Name="Launch at startup"/></Grid></Border><Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,18"><Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="8"><TextBlock Text="Background collection" FontSize="12"/><TextBlock Text="Scan logs and sync on a schedule; on Windows, keep running in the tray" Classes="muted" FontSize="10" TextWrapping="Wrap"/></StackPanel><ToggleSwitch Grid.Column="1" IsChecked="{Binding BackgroundCollection, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center" AutomationProperties.Name="Background collection"/></Grid></Border><Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,18"><Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="8"><TextBlock Text="Usage notifications" FontSize="12"/><TextBlock Text="Notify after background syncs and when attention is needed" Classes="muted" FontSize="10" TextWrapping="Wrap"/></StackPanel><ToggleSwitch Grid.Column="1" IsChecked="{Binding UsageNotifications, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center" AutomationProperties.Name="Usage notifications"/></Grid></Border>
 <Button Content="Review setup" Command="{Binding ShowFirstRunCommand}" Margin="0,16,0,0"/>
 <TextBlock Text="Local storage" Classes="heading" Margin="0,28,0,10"/>
 <Grid ColumnDefinitions="*,Auto" Margin="0,10"><StackPanel Spacing="8" Margin="0,0,12,0"><TextBlock Text="Collector data path" Classes="muted" FontSize="10"/><TextBlock Text="{Binding Settings.DataPath}" FontSize="11" TextWrapping="Wrap"/></StackPanel><Button Grid.Column="1" Content="Open folder" Click="OpenFolderClicked" VerticalAlignment="Center"/></Grid>
 <Grid ColumnDefinitions="*,Auto" Margin="0,16"><StackPanel Spacing="8" Margin="0,0,12,0"><TextBlock Text="App version" Classes="muted" FontSize="10"/><TextBlock Text="{Binding Settings.AppVersion}" FontSize="11" TextWrapping="Wrap"/></StackPanel></Grid>
 </StackPanel></Border>
 <StackPanel Grid.Column="2" Spacing="20">
 <Border Classes="card"><StackPanel Spacing="18"><TextBlock Text="Privacy &amp; retention" Classes="heading"/>
 <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,10,0,18"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Prompt content" Classes="muted" FontSize="11"/><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7"><Ellipse Classes="status-dot"/><TextBlock Text="Never collected" Foreground="{StaticResource SuccessBrush}" FontSize="11"/></StackPanel></Grid></Border>
 <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,18"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="AI responses" Classes="muted" FontSize="11"/><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7"><Ellipse Classes="status-dot"/><TextBlock Text="Never collected" Foreground="{StaticResource SuccessBrush}" FontSize="11"/></StackPanel></Grid></Border>
 <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Retention period" Classes="muted" FontSize="11" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"><ComboBox x:Name="RetentionSelector" ItemsSource="{Binding Settings.RetentionOptions}" SelectedItem="{Binding SelectedRetention, Mode=TwoWay}" MinWidth="70" AutomationProperties.Name="Retention days"/><TextBlock Text="days" VerticalAlignment="Center" FontSize="11"/></StackPanel></Grid>
 <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Cloud sync" Classes="muted" FontSize="11"/><TextBlock Grid.Column="1" Text="{Binding CloudSyncLabel}" FontSize="11"/></Grid>
 </StackPanel></Border>
 <Border Classes="card"><StackPanel Spacing="18"><TextBlock Text="Data management" Classes="heading"/><TextBlock Text="Export collected metadata as CSV or delete all usage stored on this computer." Classes="muted" FontSize="11" TextWrapping="Wrap"/>
 <WrapPanel><Button Content="Export data" Click="ExportClicked" Margin="0,0,10,8"/><Button Content="Clear local data" Command="{Binding RequestClearDataCommand}" Margin="0,0,0,8"/></WrapPanel>
 <Border IsVisible="{Binding ConfirmClearData}" BorderBrush="#F26039" BorderThickness="1" CornerRadius="8" Padding="12"><StackPanel Spacing="10"><TextBlock Text="Delete all usage stored on this computer? Old logs will not be read again; data already uploaded to the cloud is kept." TextWrapping="Wrap" FontSize="11"/><WrapPanel><Button Content="Delete local data" Command="{Binding SettingsActionCommand}" CommandParameter="clear" Margin="0,0,8,0"/><Button Content="Cancel" Command="{Binding CancelClearDataCommand}"/></WrapPanel></StackPanel></Border>
 <Border Background="{StaticResource LineBrush}" Height="1"/>
 <StackPanel Spacing="8"><TextBlock Text="Collector diagnostics" FontSize="12"/><TextBlock Text="Logs contain metadata only." Classes="muted" FontSize="10"/><Button Content="Open diagnostics" Command="{Binding OpenDiagnosticsCommand}" Margin="0,6,0,0"/></StackPanel>
 </StackPanel></Border></StackPanel></Grid>

 <Border Classes="card" IsEnabled="{Binding !IsBusy}"><StackPanel Spacing="14">
 <Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="6"><TextBlock Text="AI review" Classes="heading"/>
 <TextBlock Text="An AI model reviews your usage summary (metrics only, never prompts, code or project names) and suggests ways to save tokens." Classes="muted" FontSize="10" TextWrapping="Wrap"/></StackPanel>
 <ToggleSwitch Grid.Column="1" IsChecked="{Binding JudgeEnabled, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center" AutomationProperties.Name="AI review enabled"/></Grid>
 <Grid ColumnDefinitions="*,20,*" RowDefinitions="Auto,Auto">
 <StackPanel Spacing="6"><TextBlock Text="Provider" Classes="muted" FontSize="10"/>
 <ComboBox ItemsSource="{Binding JudgeProviderOptions}" SelectedItem="{Binding SelectedJudgeProvider, Mode=TwoWay}" HorizontalAlignment="Stretch" AutomationProperties.Name="AI review provider"/></StackPanel>
 <StackPanel Grid.Column="2" Spacing="6"><TextBlock Text="Model" Classes="muted" FontSize="10"/>
 <TextBox Text="{Binding JudgeModel, Mode=TwoWay}" Watermark="Model id" AutomationProperties.Name="AI review model"/>
 <ComboBox ItemsSource="{Binding JudgeModelOptions}" SelectedItem="{Binding SelectedJudgeModelOption, Mode=TwoWay}" PlaceholderText="Pick from the price catalog" HorizontalAlignment="Stretch" MaxDropDownHeight="320" AutomationProperties.Name="AI review model suggestions"><ComboBox.ItemTemplate><DataTemplate><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding Model}" FontSize="11"/><TextBlock Grid.Column="1" Text="{Binding CostLabel}" Classes="muted" FontSize="10" Margin="12,0,0,0"/></Grid></DataTemplate></ComboBox.ItemTemplate></ComboBox>
 <TextBlock Text="{Binding JudgeModelCost}" Classes="muted" FontSize="10"/></StackPanel>
 <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Spacing="6" Margin="0,14,0,0"><TextBlock Text="API key" Classes="muted" FontSize="10"/>
 <TextBox Text="{Binding JudgeApiKey, Mode=TwoWay}" PasswordChar="•" Watermark="Paste API key" AutomationProperties.Name="AI review API key"/>
 <TextBlock Text="{Binding JudgeKeyState}" Classes="muted" FontSize="10" TextWrapping="Wrap"/>
 <TextBlock Text="{Binding JudgeKeyHint}" Classes="muted" FontSize="10" TextWrapping="Wrap"/></StackPanel></Grid>
 <WrapPanel><Button Content="Save AI review" Command="{Binding SaveJudgeCommand}" Margin="0,0,10,8"/><Button Content="Test connection" Command="{Binding TestJudgeConnectionCommand}" Margin="0,0,10,8"/><Button Content="Run AI review now" Command="{Binding RunJudgeNowCommand}" Margin="0,0,0,8"/></WrapPanel>
 <TextBlock Text="{Binding JudgeMessage}" IsVisible="{Binding HasJudgeMessage}" TextWrapping="Wrap" FontSize="11" Classes="judge-message" Classes.judge-error="{Binding JudgeMessageIsError}"/>
 <Border Background="{StaticResource LineBrush}" Height="1"/>
 <Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="6"><TextBlock Text="{Binding JudgeStatusLabel}" FontSize="12"/><TextBlock Text="{Binding JudgeHeadline}" IsVisible="{Binding JudgeHeadline, Converter={x:Static ObjectConverters.IsNotNull}}" Classes="muted" FontSize="11" TextWrapping="Wrap"/></StackPanel>
 <TextBlock Grid.Column="1" Text="{Binding JudgeLastRunLabel}" Classes="muted" FontSize="10" VerticalAlignment="Top" TextWrapping="Wrap" MaxWidth="260"/></Grid>
 </StackPanel></Border>

 <TextBlock Text="Preferences are saved on this computer. Launch at startup uses the autostart folder on Linux and the Run registry key on Windows. Retention deletes usage older than the selected period after each scan." Classes="muted" FontSize="10" TextWrapping="Wrap"/>
 </StackPanel>
</UserControl>
