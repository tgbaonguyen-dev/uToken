<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="UToken.Desktop.App.Views.PairingStateView" x:CompileBindings="False">
 <Border Classes="card" Padding="30"><StackPanel Spacing="28">
  <Border Background="#191C20" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="9" Padding="10,7" HorizontalAlignment="Left"><StackPanel Orientation="Horizontal" Spacing="8"><Ellipse Classes="status-dot" Fill="{Binding ActivePairingScenario.Accent}"/><TextBlock Text="{Binding ActivePairingScenario.Status}" FontSize="11"/></StackPanel></Border>
  <Grid ColumnDefinitions="72,24,*"><Border Width="72" Height="72" CornerRadius="20" Background="#191A1C" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" VerticalAlignment="Top"><TextBlock Text="{Binding ActivePairingScenario.Code}" Foreground="{Binding ActivePairingScenario.Accent}" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="2" Spacing="12"><TextBlock Text="{Binding ActivePairingScenario.Headline}" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding ActivePairingScenario.Description}" Classes="muted" TextWrapping="Wrap"/></StackPanel></Grid>
  <StackPanel Spacing="14"><TextBlock Text="DETAILS" Classes="label"/><Border Background="#191A1C" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="14" Padding="20,4"><ItemsControl ItemsSource="{Binding ActivePairingScenario.Details}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,18"><Grid ColumnDefinitions="*,*"><TextBlock Text="{Binding Label}" FontSize="12" TextWrapping="Wrap" Margin="0,0,12,0"/><TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="{Binding Color}" FontSize="12" TextWrapping="Wrap" TextAlignment="Right"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Border></StackPanel>
  <ProgressBar IsVisible="{Binding IsPairingVerifying}" IsIndeterminate="True" Foreground="#4089EF" Height="6"/>
  <TextBlock Text="{Binding PairingMessage}" Foreground="{Binding ActivePairingScenario.Accent}" TextWrapping="Wrap"/>
  <Border Background="#191A1C" CornerRadius="12" Padding="16" IsVisible="{Binding ShowPairedDeviceSummary}"><Grid ColumnDefinitions="48,16,*"><Border Background="#24282D" CornerRadius="14" Width="48" Height="48"><TextBlock Text="{Binding Sync.Device.Initial}" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="2" Spacing="8"><TextBlock Text="{Binding Sync.Device.Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Sync.Device.Platform}" Classes="muted" FontSize="11"/><StackPanel Orientation="Horizontal" Spacing="8"><Ellipse Classes="status-dot" Fill="{Binding Sync.Device.ConnectionColor}"/><TextBlock Text="{Binding Sync.Device.ConnectionLabel}" Foreground="{Binding Sync.Device.ConnectionColor}" FontSize="11"/></StackPanel></StackPanel></Grid></Border>
  <WrapPanel IsEnabled="{Binding !IsBusy}"><Button Classes="primary" Content="{Binding ActivePairingScenario.PrimaryLabel}" Command="{Binding PairingStateActionCommand}" CommandParameter="{Binding ActivePairingScenario.PrimaryAction}" MinWidth="180" Margin="0,0,12,8"/><Button Content="{Binding ActivePairingScenario.SecondaryLabel}" Command="{Binding PairingStateActionCommand}" CommandParameter="{Binding ActivePairingScenario.SecondaryAction}" Margin="0,0,0,8"/></WrapPanel>
  <TextBlock Text="Only usage metadata is synced. Prompt content never leaves this computer." Classes="muted" FontSize="10" TextWrapping="Wrap"/>
 </StackPanel></Border>
</UserControl>
