<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Avalonia.Svg.Skia" x:Class="UToken.Desktop.App.Views.SyncStateView" x:CompileBindings="False">
 <UserControl.Resources>
  <DataTemplate x:Key="SyncDetail"><Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,16"><Grid ColumnDefinitions="*,*"><TextBlock Text="{Binding Label}" Classes="muted" FontSize="11" TextWrapping="Wrap" Margin="0,0,12,0"/><TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="{Binding Color}" FontSize="11" TextWrapping="Wrap" TextAlignment="Right"/></Grid></Border></DataTemplate>
 </UserControl.Resources>
 <StackPanel Spacing="24">
  <Border Classes="card" Padding="28" ClipToBounds="True"><Grid>
   <Ellipse Width="310" Height="220" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-100,-40,0" Opacity="0.12" Fill="{Binding ActiveSyncScenario.Accent}" IsVisible="{Binding IsSyncFailure}"><Ellipse.Effect><BlurEffect Radius="70"/></Ellipse.Effect></Ellipse>
   <StackPanel Spacing="24">
    <Border Background="#191C20" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="9" Padding="10,7" HorizontalAlignment="Left"><StackPanel Orientation="Horizontal" Spacing="8"><Ellipse Classes="status-dot" Fill="{Binding ActiveSyncScenario.Accent}"/><TextBlock Text="{Binding ActiveSyncScenario.Status}" FontSize="10"/></StackPanel></Border>
    <Grid ColumnDefinitions="64,24,*"><Border Width="64" Height="64" CornerRadius="20" Background="#191C20" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" VerticalAlignment="Top"><TextBlock Text="{Binding ActiveSyncScenario.Code}" Foreground="{Binding ActiveSyncScenario.Accent}" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="2" Spacing="12"><TextBlock Text="{Binding ActiveSyncScenario.Headline}" FontSize="25" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding ActiveSyncScenario.Description}" Classes="muted" FontSize="12" TextWrapping="Wrap"/><TextBlock Text="{Binding Sync.Device.LastSync, StringFormat='Last successful sync: {0}'}" Classes="muted" FontSize="10" IsVisible="{Binding IsSyncFailure}"/></StackPanel></Grid>
    <StackPanel IsVisible="{Binding !IsSyncFailure}" Spacing="12"><TextBlock Text="DETAILS" Classes="label"/><Border Background="#191A1C" CornerRadius="14" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="20,4"><ItemsControl ItemsSource="{Binding SyncStateDetails}" ItemTemplate="{StaticResource SyncDetail}"/></Border></StackPanel>
    <StackPanel IsVisible="{Binding IsSyncProgress}" Spacing="10"><ProgressBar x:Name="SyncStateProgress" IsIndeterminate="True" Foreground="#4089EF" Height="6"/><TextBlock Text="{Binding SyncMessage}" Classes="muted" TextWrapping="Wrap" IsVisible="{Binding IsSyncing}"/></StackPanel>
    <WrapPanel IsEnabled="{Binding !IsBusy}"><Button Classes="primary" Content="{Binding ActiveSyncScenario.PrimaryLabel}" Command="{Binding SectionStateActionCommand}" CommandParameter="{Binding ActiveSyncScenario.PrimaryAction}" MinWidth="160" Margin="0,0,12,8"/><Button Content="{Binding ActiveSyncScenario.SecondaryLabel}" Command="{Binding SectionStateActionCommand}" CommandParameter="{Binding ActiveSyncScenario.SecondaryAction}" Margin="0,0,12,8"/><Border Background="#191C20" CornerRadius="9" Padding="10,7" IsVisible="{Binding IsSyncFailure}" Margin="0,0,0,8" VerticalAlignment="Center"><StackPanel Orientation="Horizontal" Spacing="8"><Ellipse Classes="status-dot" Fill="#D14DA6"/><TextBlock Text="{Binding SyncQueuedLabel}" FontSize="10"/></StackPanel></Border></WrapPanel>
    <TextBlock Text="Only usage metadata and encrypted summaries are synced." Classes="muted" FontSize="10" TextWrapping="Wrap"/>
   </StackPanel>
  </Grid></Border>
  <Grid ColumnDefinitions="1.7*,20,*" IsVisible="{Binding IsSyncFailure}">
   <Border Classes="card"><StackPanel Spacing="18"><TextBlock Text="Queued data" Classes="heading"/><ItemsControl ItemsSource="{Binding SyncStateConfig.Queue}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,18"><Grid ColumnDefinitions="32,12,*,Auto,16,Auto"><svg:Svg Path="{Binding Logo}" Width="32" Height="32"/><TextBlock Grid.Column="2" Text="{Binding Name}" VerticalAlignment="Center" FontSize="11"/><TextBlock Grid.Column="3" Text="{Binding EventLabel}" Classes="muted" VerticalAlignment="Center" FontSize="10"/><TextBlock Grid.Column="5" Text="{Binding SizeLabel}" VerticalAlignment="Center" FontSize="11"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><StackPanel Orientation="Horizontal" Spacing="8"><Ellipse Classes="status-dot"/><TextBlock Text="Usage history is preserved while sync is unavailable." Classes="muted" FontSize="10" TextWrapping="Wrap"/></StackPanel></StackPanel></Border>
   <Border Grid.Column="2" Classes="card"><StackPanel Spacing="18"><TextBlock Text="Connection details" Classes="heading"/><ItemsControl ItemsSource="{Binding SyncStateDetails}" ItemTemplate="{StaticResource SyncDetail}"/><TextBlock Text="Queue counts are events in daily summaries not yet uploaded. Retry runs a full sync." Classes="muted" FontSize="10" TextWrapping="Wrap"/></StackPanel></Border>
  </Grid>
 </StackPanel>
</UserControl>
