<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 x:Class="UToken.Desktop.App.Views.FirstRunView" x:CompileBindings="False">
 <StackPanel Spacing="28" IsEnabled="{Binding !IsBusy}">
 <Border Classes="card" Padding="32" MinHeight="420">
 <StackPanel Spacing="28"><TextBlock Text="SETUP CHECKLIST" Classes="label"/>
 <ItemsControl ItemsSource="{Binding SetupRows}"><ItemsControl.ItemTemplate><DataTemplate>
 <Border Background="#191A1C" CornerRadius="16" Padding="18,15" Margin="0,0,0,22">
 <Grid ColumnDefinitions="40,20,*,Auto">
 <Border Background="{StaticResource PageBrush}" CornerRadius="12" Width="40" Height="40"><TextBlock Text="{Binding Number}" Foreground="{Binding Color}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/></Border>
 <StackPanel Grid.Column="2" Spacing="8" VerticalAlignment="Center"><TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="{Binding Description}" Classes="muted" FontSize="11" TextWrapping="Wrap"/></StackPanel>
 <TextBlock Grid.Column="3" Text="{Binding Status}" Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center" FontSize="10" Margin="12,0,0,0"/>
 </Grid></Border>
 </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
 </StackPanel></Border>
 <WrapPanel><Button Classes="primary" Content="{Binding SetupAction}" Command="{Binding ContinueSetupCommand}" MinWidth="270" Margin="0,0,16,12"/><TextBlock Text="Takes about 2 minutes" Classes="muted" FontSize="10" VerticalAlignment="Center" Margin="0,0,16,12"/><Button Content="Skip setup" IsVisible="{Binding CanSkipSetup}" Command="{Binding SkipSetupCommand}" Margin="0,0,0,12"/></WrapPanel>
 <TextBlock Text="{Binding SetupMessage}" IsVisible="{Binding HasSetupMessage}" Foreground="{Binding SetupMessageColor}" TextWrapping="Wrap"/>
 <TextBlock Text="Usage is read from local logs on this computer. Only daily summaries are uploaded after you sign in; prompts and code never leave this computer." Classes="muted" FontSize="11" TextWrapping="Wrap"/>
 </StackPanel>
</UserControl>