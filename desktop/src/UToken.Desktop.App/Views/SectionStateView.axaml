<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="UToken.Desktop.App.Views.SectionStateView" x:CompileBindings="False">
 <Border Classes="card" Padding="28"><StackPanel Spacing="24">
  <Border Background="#191C20" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="9" Padding="10,7" HorizontalAlignment="Left"><StackPanel Orientation="Horizontal" Spacing="8"><Ellipse Classes="status-dot" Fill="{Binding SectionScenario.Accent}"/><TextBlock Text="{Binding SectionScenario.Status}" FontSize="11"/></StackPanel></Border>
  <Grid ColumnDefinitions="72,24,*"><Border Width="72" Height="72" CornerRadius="20" Background="#191A1C" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" VerticalAlignment="Top"><TextBlock Text="{Binding SectionScenario.Code}" Foreground="{Binding SectionScenario.Accent}" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="2" Spacing="12"><TextBlock Text="{Binding SectionScenario.Headline}" FontSize="25" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding SectionScenario.Description}" Classes="muted" TextWrapping="Wrap"/></StackPanel></Grid>
  <StackPanel Spacing="14"><TextBlock Text="DETAILS" Classes="label"/><Border Background="#191A1C" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="14" Padding="20,4"><ItemsControl ItemsSource="{Binding SectionScenario.Details}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,18"><Grid ColumnDefinitions="*,*"><TextBlock Text="{Binding Label}" Classes="muted" TextWrapping="Wrap" Margin="0,0,12,0"/><TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="{Binding Color}" TextAlignment="Right" TextWrapping="Wrap"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Border></StackPanel>
  <WrapPanel IsEnabled="{Binding !IsBusy}"><Button Classes="primary" Content="{Binding SectionScenario.PrimaryLabel}" Command="{Binding SectionStateActionCommand}" CommandParameter="{Binding SectionScenario.PrimaryAction}" Margin="0,0,12,8"/><Button Content="{Binding SectionScenario.SecondaryLabel}" Command="{Binding SectionStateActionCommand}" CommandParameter="{Binding SectionScenario.SecondaryAction}" Margin="0,0,0,8"/></WrapPanel>
 </StackPanel></Border>
</UserControl>
