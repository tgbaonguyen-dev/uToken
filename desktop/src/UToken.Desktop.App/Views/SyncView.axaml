<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="UToken.Desktop.App.Views.SyncView" x:CompileBindings="False">
 <StackPanel Spacing="20">
  <ProgressBar IsVisible="{Binding IsSyncing}" IsIndeterminate="True" Foreground="{StaticResource SuccessBrush}"/>
  <TextBlock IsVisible="{Binding HasSyncMessage}" Text="{Binding SyncMessage}" Foreground="{Binding SyncMessageColor}" TextWrapping="Wrap"/>
  <Grid ColumnDefinitions="1.9*,20,*">
   <Border Classes="card"><StackPanel Spacing="24">
    <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Google account" Classes="heading"/><Border Grid.Column="1" Background="#191C20" CornerRadius="10" Padding="10,6" IsVisible="{Binding HasDevice}"><StackPanel Orientation="Horizontal" Spacing="8"><Ellipse Classes="status-dot" Fill="{Binding Sync.Device.ConnectionColor}"/><TextBlock Text="{Binding Sync.Device.ConnectionLabel}" FontSize="10"/></StackPanel></Border></Grid>
    <StackPanel IsVisible="{Binding HasDevice}" Spacing="22">
     <Grid ColumnDefinitions="56,*"><Border Background="#191C20" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="16" Height="48" Width="48"><TextBlock Text="{Binding Sync.Device.Initial}" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center"><TextBlock Text="{Binding Sync.Device.Name}" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding Sync.Device.Platform}" Classes="muted" FontSize="11"/><TextBlock Text="{Binding Sync.Device.Version}" Classes="muted" FontSize="10"/></StackPanel></Grid>
     <WrapPanel><StackPanel Margin="0,0,26,12" Spacing="8"><TextBlock Text="Last upload" Classes="muted" FontSize="10"/><TextBlock Text="{Binding Sync.Device.LastSync}" FontSize="12"/></StackPanel><StackPanel Margin="0,0,26,12" Spacing="8"><TextBlock Text="Data uploaded" Classes="muted" FontSize="10"/><TextBlock Text="{Binding Sync.Device.Transferred}" FontSize="12"/></StackPanel><Button Content="Sign out" Command="{Binding RequestDisconnectCommand}" IsEnabled="{Binding !IsBusy}"/></WrapPanel>
    </StackPanel>
    <StackPanel IsVisible="{Binding HasNoDevice}" Spacing="16"><TextBlock Text="Not signed in" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Sign in with the Google account you use in uToken mobile to upload your daily usage summaries." Classes="muted" TextWrapping="Wrap"/><Button Content="Sign in with Google" Command="{Binding SignInCommand}" HorizontalAlignment="Left" IsEnabled="{Binding !IsBusy}"/></StackPanel>
    <Border BorderBrush="#F26039" BorderThickness="1" CornerRadius="10" Padding="12" IsVisible="{Binding ConfirmDisconnect}"><StackPanel Spacing="12"><TextBlock Text="Sign out of Google on this computer? Local usage and data already in the cloud are kept." TextWrapping="Wrap"/><WrapPanel><Button Content="Sign out" Command="{Binding DisconnectCommand}" Margin="0,0,8,0" IsEnabled="{Binding !IsBusy}"/><Button Content="Cancel" Command="{Binding CancelDisconnectCommand}" IsEnabled="{Binding !IsBusy}"/></WrapPanel></StackPanel></Border>
   </StackPanel></Border>
   <Border Grid.Column="2" Classes="card"><StackPanel Spacing="20"><TextBlock Text="Encrypted sync" Classes="heading"/><Grid ColumnDefinitions="18,*"><Ellipse Classes="status-dot" HorizontalAlignment="Left"/><TextBlock Grid.Column="1" Text="{Binding Sync.EncryptionTitle}" FontSize="11" TextWrapping="Wrap"/></Grid><TextBlock Text="{Binding Sync.EncryptionDescription}" Classes="muted" FontSize="10" TextWrapping="Wrap"/><Border Height="1" Background="{StaticResource LineBrush}"/>
    <ItemsControl ItemsSource="{Binding Sync.Privacy}"><ItemsControl.ItemTemplate><DataTemplate><Grid ColumnDefinitions="*,Auto" Margin="0,8"><TextBlock Text="{Binding Label}" FontSize="10"/><TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="{Binding Color}" FontSize="10"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   </StackPanel></Border>
  </Grid>
  <Border Classes="card"><StackPanel Spacing="20">
   <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Sync history" Classes="heading"/><Border Grid.Column="1" Background="#191C20" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="9" Padding="10,6"><StackPanel Orientation="Horizontal" Spacing="8"><Ellipse Classes="status-dot"/><TextBlock Text="This session" Classes="muted" FontSize="10"/></StackPanel></Border></Grid>
   <Grid ColumnDefinitions="70,*,80,90,90"><TextBlock Text="TIME" Classes="label"/><TextBlock Grid.Column="1" Text="ACCOUNT" Classes="label"/><TextBlock Grid.Column="2" Text="EVENTS" Classes="label" TextAlignment="Right"/><TextBlock Grid.Column="3" Text="SIZE" Classes="label" TextAlignment="Right"/><TextBlock Grid.Column="4" Text="RESULT" Classes="label" TextAlignment="Right"/></Grid>
   <ItemsControl ItemsSource="{Binding Sync.History}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,16"><Grid ColumnDefinitions="70,*,80,90,90"><TextBlock Text="{Binding Time}" Classes="muted" FontSize="11"/><TextBlock Grid.Column="1" Text="{Binding Device}" FontSize="11"/><TextBlock Grid.Column="2" Text="{Binding Events}" TextAlignment="Right" FontSize="11"/><TextBlock Grid.Column="3" Text="{Binding Size}" TextAlignment="Right" FontSize="11"/><TextBlock Grid.Column="4" Text="{Binding Result}" TextAlignment="Right" Foreground="{Binding Color}" FontSize="11"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   <TextBlock Text="No synchronization history yet." Classes="muted" IsVisible="{Binding IsSyncHistoryEmpty}"/>
  </StackPanel></Border>
 </StackPanel>
</UserControl>