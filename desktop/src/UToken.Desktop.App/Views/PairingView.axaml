<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Avalonia.Svg.Skia" x:Class="UToken.Desktop.App.Views.PairingView" x:CompileBindings="False">
 <StackPanel Spacing="28">
  <Border Classes="card" IsVisible="{Binding IsRealPairing}"><StackPanel Spacing="12"><TextBlock Text="Google account" Classes="heading"/><TextBlock Text="{Binding GoogleAccount}" TextWrapping="Wrap"/><WrapPanel><Button Content="Sign in with Google" Command="{Binding SignInGoogleCommand}" IsEnabled="{Binding !IsBusy}" Margin="0,0,12,0"/><Button Content="Sign out" Command="{Binding SignOutGoogleCommand}" IsEnabled="{Binding !IsBusy}"/></WrapPanel></StackPanel></Border>
  <Grid ColumnDefinitions="2.3*,20,*">
   <Border Classes="card" Padding="30"><StackPanel Spacing="28">
    <TextBlock Text="PAIRING CODE" Classes="label" IsVisible="{Binding CanEnterPairing}"/><TextBlock Text="CONNECTED DEVICE" Classes="label" IsVisible="{Binding IsPaired}"/>
    <ItemsControl ItemsSource="{Binding PairingDigits}" IsEnabled="{Binding !IsBusy}" IsVisible="{Binding CanEnterPairing}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="6"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
     <TextBox Text="{Binding Text, Mode=TwoWay}" MaxLength="16" TextChanged="DigitChanged" KeyDown="DigitKeyDown" Height="76" Margin="0,0,10,0" FontSize="30" TextAlignment="Center" VerticalContentAlignment="Center" Background="#191A1C" BorderThickness="0" CornerRadius="14" AutomationProperties.Name="Pairing code character"/>
    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    <TextBlock IsVisible="{Binding CanEnterPairing}" Text="{Binding PairingCountdownLabel}" Foreground="#F26039" FontSize="11"/>
    <TextBlock Text="{Binding PairingMessage}" Foreground="{Binding PairingMessageColor}" TextWrapping="Wrap"/>
    <Button Classes="primary" Content="Pair device" Command="{Binding PairDeviceCommand}" IsEnabled="{Binding !IsBusy}" IsVisible="{Binding CanEnterPairing}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
    <StackPanel IsVisible="{Binding IsPaired}" Spacing="20">
     <Grid ColumnDefinitions="60,*"><Border Background="#191C20" CornerRadius="14" Width="48" Height="48"><TextBlock Text="{Binding Sync.Device.Initial}" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Spacing="8"><TextBlock Text="{Binding Sync.Device.Name}" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="{Binding Sync.Device.Platform}" Classes="muted"/><TextBlock Text="{Binding Sync.Device.ConnectionLabel}" Foreground="{Binding Sync.Device.ConnectionColor}" FontSize="11"/><TextBlock Text="{Binding Sync.Device.Version}" Classes="muted" FontSize="11"/></StackPanel></Grid>
     <Grid ColumnDefinitions="*,*"><StackPanel Spacing="8"><TextBlock Text="Last sync" Classes="muted" FontSize="11"/><TextBlock Text="{Binding Sync.Device.LastSync}"/></StackPanel><StackPanel Grid.Column="1" Spacing="8"><TextBlock Text="Data transferred" Classes="muted" FontSize="11"/><TextBlock Text="{Binding Sync.Device.Transferred}"/></StackPanel></Grid>
    </StackPanel>
    <Button Classes="primary" Content="Open Sync" Command="{Binding ShowSyncCommand}" IsVisible="{Binding IsPaired}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
    <Button IsVisible="{Binding CanEnterPairing}" Content="Start new pairing session" Command="{Binding RestartPairingCommand}" IsEnabled="{Binding !IsBusy}" HorizontalAlignment="Left"/>
    <TextBlock IsVisible="{Binding CanEnterPairing}" Text="{Binding Pairing.DemoHint}" Classes="muted" FontSize="11" TextWrapping="Wrap"/>
   </StackPanel></Border>
   <Border Grid.Column="2" Classes="card"><StackPanel Spacing="30"><TextBlock Text="SECURE BY DEFAULT" Classes="label"/>
    <ItemsControl ItemsSource="{Binding Pairing.SecurityItems}"><ItemsControl.ItemTemplate><DataTemplate><Grid ColumnDefinitions="26,10,*" Margin="0,12"><Border Background="#191C20" CornerRadius="7" Width="26" Height="26"><TextBlock Text="&#x2713;" Foreground="{StaticResource SuccessBrush}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Grid.Column="2" Text="{Binding}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   </StackPanel></Border>
  </Grid>
  <Border Classes="card"><StackPanel Spacing="20"><TextBlock Text="SUPPORTED SOURCES" Classes="label"/>
   <ItemsControl ItemsSource="{Binding SupportedSources}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border ToolTip.Tip="{Binding Availability}" Classes="supported-source" Background="#191A1C" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="14,10" MinWidth="170" Margin="0,0,12,8"><StackPanel Orientation="Horizontal" Spacing="12"><svg:Svg Path="{Binding Logo}" Width="32" Height="32"/><Ellipse Classes="status-dot" Fill="{Binding Color}"/><TextBlock Text="{Binding Name}" VerticalAlignment="Center"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  </StackPanel></Border>
 </StackPanel>
</UserControl>
