{
  "type": "object",
  "additionalProperties": false,
  "required": ["score", "grade", "headline", "dimensions", "insights"],
  "properties": {
    "score": { "type": ["integer", "null"], "minimum": 0, "maximum": 100 },
    "grade": { "type": ["string", "null"], "enum": ["A", "B", "C", "D", null] },
    "headline": { "type": "string" },
    "dimensions": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "score", "comment"],
        "properties": {
          "id": { "enum": ["cache", "context", "reasoning", "reliability", "outcomes", "hidden_cost"] },
          "score": { "type": ["integer", "null"] }, "comment": { "type": "string" }
        }
      }
    },
    "insights": {
      "type": "array", "maxItems": 5,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "title", "severity", "category", "provider", "evidence", "recommendation", "estimated_impact", "estimated_saving_usd_per_month", "confidence"],
        "properties": {
          "id": { "type": "string" }, "title": { "type": "string" },
          "severity": { "enum": ["high", "medium", "low"] },
          "category": { "enum": ["cache", "context", "reasoning", "reliability", "outcomes", "hidden_cost"] },
          "provider": { "type": ["string", "null"], "enum": ["codex", "claude_code", "antigravity", null] },
          "evidence": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["metric"], "properties": { "metric": { "type": "string" } } } },
          "recommendation": { "type": "string" }, "estimated_impact": { "type": ["string", "null"] },
          "estimated_saving_usd_per_month": { "type": ["number", "null"] },
          "confidence": { "enum": ["high", "medium", "low"] }
        }
      }
    }
  }
}
