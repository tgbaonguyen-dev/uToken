{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "users/{uid}/sync_requests/{id}",
  "type": "object",
  "required": [
    "trigger",
    "state",
    "created_at"
  ],
  "properties": {
    "trigger": {
      "enum": [
        "screen_open",
        "manual_refresh",
        "ai_review"
      ]
    },
    "state": {
      "enum": [
        "pending",
        "running",
        "done",
        "failed"
      ]
    },
    "error_code": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_at": {
      "type": "string"
    },
    "finished_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "started_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "UTC lease start written by desktop when claiming a request. Optional for legacy running requests, which are recoverable immediately."
    }
  }
}
