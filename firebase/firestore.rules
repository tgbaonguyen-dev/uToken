rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    // Bảng giá dùng chung: ai cũng đọc được, không ai ghi từ client.
    match /pricing/{doc=**} {
      allow read: if true;
      allow write: if false;
    }

    // Mọi dữ liệu người dùng: chỉ chủ tài khoản đọc/ghi.
    match /users/{uid} {
      allow read, write: if isOwner(uid);

      function pairingPath() { return /databases/$(database)/documents/users/$(uid)/pairing/current; }
      function connectionPath(id) { return /databases/$(database)/documents/users/$(uid)/connections/$(id); }
      function validPending(d) {
        return d.keys().hasAll(['schemaVersion','state','code','connectionId','mobileName','desktopName','desktopId','createdAt','pairedAt','revokedAt','cancelledAt'])
          && d.keys().hasOnly(['schemaVersion','state','code','connectionId','mobileName','desktopName','desktopId','createdAt','pairedAt','revokedAt','cancelledAt'])
          && d.schemaVersion == 2 && d.state == 'pending'
          && d.code is string && d.code.matches('^[A-HJ-NP-Z2-9]{6}$')
          && d.connectionId is string && d.connectionId.matches('^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$')
          && !exists(connectionPath(d.connectionId))
          && d.mobileName is string && d.mobileName.size() > 0 && d.mobileName.size() <= 100
          && d.desktopName == '' && d.desktopId == ''
          && d.createdAt == request.time && d.pairedAt == null && d.revokedAt == null && d.cancelledAt == null;
      }
      match /pairing/{id} {
        allow get: if isOwner(uid) && id == 'current';
        allow create: if isOwner(uid) && id == 'current' && validPending(request.resource.data);
        allow update: if isOwner(uid) && id == 'current' && (
          (resource.data.state in ['pending','cancelled','revoked'] && validPending(request.resource.data)) ||
          (resource.data.state == 'pending' && request.resource.data.state == 'paired'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state','desktopId','desktopName','pairedAt'])
            && request.resource.data.desktopId is string && request.resource.data.desktopId.matches('^[a-f0-9]{32}$')
            && request.resource.data.desktopName is string && request.resource.data.desktopName.size() > 0 && request.resource.data.desktopName.size() <= 100
            && request.resource.data.pairedAt == request.time
            && request.time < resource.data.createdAt + duration.value(10,'m')
            && getAfter(connectionPath(resource.data.connectionId)).data == request.resource.data) ||
          (resource.data.state == 'paired' && request.resource.data.state == 'revoked'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state','revokedAt'])
            && request.resource.data.revokedAt == request.time
            && getAfter(connectionPath(resource.data.connectionId)).data == request.resource.data) ||
          (resource.data.state == 'pending' && request.resource.data.state == 'cancelled'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state','cancelledAt'])
            && request.resource.data.cancelledAt == request.time)
        );
        allow delete, list: if false;
      }
      match /connections/{id} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && request.resource.data.connectionId == id
          && request.resource.data.state == 'paired'
          && getAfter(pairingPath()).data == request.resource.data;
        allow update: if isOwner(uid) && resource.data.state == 'paired'
          && request.resource.data.state == 'revoked'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state','revokedAt'])
          && request.resource.data.revokedAt == request.time
          && getAfter(pairingPath()).data == request.resource.data;
        allow delete: if false;
      }

      match /daily/{date} {
        allow read, delete: if isOwner(uid);
        // Firestore enforces its document byte limit; Resource has no size() method.
        allow create, update: if isOwner(uid)
          && date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.schema_version == 2;
      }

      match /sync_requests/{id} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid)
          && request.resource.data.trigger in ['screen_open', 'manual_refresh']
          && request.resource.data.state == 'pending';
        allow update: if isOwner(uid);
      }

      match /{collection}/{rest=**} {
        // Overlapping allows are OR'ed; don't bypass the validated collections.
        allow read, write: if isOwner(uid) && !(collection in ['daily', 'sync_requests', 'pairing', 'connections']);
      }
    }
  }
}
