rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    // Bảng giá dùng chung: ai cũng đọc được, không ai ghi từ client.
    match /pricing/{doc=**} {
      allow read: if true;
      allow write: if false;
    }

    // Mọi dữ liệu người dùng: chỉ chủ tài khoản đọc/ghi.
    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /daily/{date} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.schema_version == 2;
        // Rules have no serialized-document byte-size API. The sync producer
        // must enforce the contract's 900 KB bound before sending a summary.
        allow delete: if isOwner(uid);
      }

      match /sync_requests/{id} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid)
          && request.resource.data.trigger in ['screen_open', 'manual_refresh']
          && request.resource.data.state == 'pending';
        allow update: if isOwner(uid)
          && request.resource.data.trigger == resource.data.trigger
          && request.resource.data.trigger in ['screen_open', 'manual_refresh']
          && request.resource.data.state in ['pending', 'running', 'done', 'failed'];
      }

      match /{collection}/{rest=**} {
        // Overlapping allow rules are OR-ed: do not bypass the validations above.
        allow read, write: if isOwner(uid)
          && !(collection in ['daily', 'sync_requests']);
      }
    }
  }
}
